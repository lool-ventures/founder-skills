#!/usr/bin/env bash
# Canonical pre-commit hook (version-controlled). Activate with:
#   git config core.hooksPath scripts/hooks
#
# Runs: (1) ruff format + lint on staged Python, (2) the privacy-leak guard on
# all staged files. Bypass a confirmed false positive with `git commit --no-verify`.

set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# --- 1. ruff on staged Python -------------------------------------------------
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' || true)
if [ -n "$staged_py" ]; then
  if ! uv run ruff format --check $staged_py; then
    echo ""
    echo "Pre-commit: ruff format failed. Run 'uv run ruff format .' to fix."
    exit 1
  fi
  if ! uv run ruff check $staged_py; then
    echo ""
    echo "Pre-commit: ruff check failed. Run 'uv run ruff check --fix .' to fix."
    exit 1
  fi
fi

# --- 2. the plugin's script hashes ---------------------------------------------
# A staged plugin .py, agent body or the manifest itself: the working tree must match
# data/script-hashes.json (the dispatch-prompt hook checks the plugin against it).
staged_hashed=$(git diff --cached --name-only --diff-filter=ACMD -- 'founder-skills/*.py' \
  'founder-skills/agents/*.md' 'founder-skills/data/script-hashes.json' ':!founder-skills/tests/' || true)
if [ -n "$staged_hashed" ]; then
  if ! python3 founder-skills/scripts/script_hashes.py --check; then
    echo ""
    echo "Pre-commit: regenerate the hashes with 'python3 founder-skills/scripts/script_hashes.py --write' and stage data/script-hashes.json."
    exit 1
  fi
fi

# --- 3. privacy-leak guard on all staged files --------------------------------
# Layers: stray confidential documents, named-after-company provenance tags, and
# exact names from the local (git-ignored) denylist. See scripts/privacy_guard.py.
# Run the guard that sits beside this hook script, so every worktree runs the guard of the checkout
# core.hooksPath points at. Keep any `cd` inside $( ... ): from the main checkout git sets no GIT_DIR,
# so a bare `cd` out of the work tree loses the repo. A hook copied or symlinked into .git/hooks, or a
# symlinked hooksPath, has no guard beside it: fall back to the work tree's own.
guard="$(cd "$(dirname "$0")/.." && pwd)/privacy_guard.py"
[ -f "$guard" ] || guard="$(git rev-parse --show-toplevel)/scripts/privacy_guard.py"
if ! uv run python "$guard" --staged; then
  exit 1
fi
