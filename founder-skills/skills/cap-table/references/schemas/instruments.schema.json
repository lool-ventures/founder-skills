{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cap-table instruments.json",
  "type": "object",
  "required": ["safes", "convertible_notes", "warrants", "option_grants", "metadata"],
  "properties": {
    "safes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "investor_name", "purchase_amount", "issuance_date", "form", "extraction_confidence"],
        "properties": {
          "id": {"type": "string"},
          "investor_name": {"type": ["string", "null"]},
          "purchase_amount": {"type": ["number", "null"]},
          "post_money_valuation_cap": {"type": ["number", "null"]},
          "pre_money_valuation_cap": {"type": ["number", "null"]},
          "discount_multiplier": {"type": ["number", "null"]},
          "mfn_provision": {
            "type": ["object", "null"],
            "properties": {
              "present": {"type": "boolean"},
              "elected": {"type": "boolean"},
              "elected_against_safe_id": {"type": ["string", "null"]},
              "cherry_pick_attempted": {"type": "boolean"},
              "notes": {"type": ["string", "null"]}
            }
          },
          "pro_rata_side_letter": {
            "type": ["object", "null"],
            "properties": {
              "present": {"type": "boolean"},
              "investor_scope": {"enum": ["this_investor_only", "major_investor_class", "all_safes", "other"]},
              "exercise_cap_percent": {"type": ["number", "null"]},
              "notes": {"type": ["string", "null"]}
            }
          },
          "issuance_date": {"type": ["string", "null"]},
          "form": {"enum": ["yc_postmoney_cap", "yc_postmoney_discount", "yc_uncapped_mfn", "cap_plus_discount", "yc_premoney_cap_only", "pre_money_cap_and_discount_legacy", "other"]},
          "conversion_price_override": {"type": ["number", "null"]},
          "source_document": {"type": ["string", "null"]},
          "extraction_confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "convertible_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "investor_name", "principal", "interest_rate_type", "issuance_date", "extraction_confidence"],
        "properties": {
          "id": {"type": "string"},
          "investor_name": {"type": ["string", "null"]},
          "principal": {"type": ["number", "null"]},
          "annual_interest_rate": {"type": ["number", "null"]},
          "interest_rate_type": {"enum": ["fixed_numeric", "fixed_numeric_simple", "statutory_ita_section_3j", "none"]},
          "day_count_basis": {"type": ["integer", "null"]},
          "compounding_periods_per_year": {"type": ["integer", "null"]},
          "interest_converts_to_shares": {"type": "boolean"},
          "issuance_date": {"type": ["string", "null"]},
          "last_interest_event_date": {"type": ["string", "null"]},
          "valuation_cap": {"type": ["number", "null"]},
          "discount_multiplier": {"type": ["number", "null"]},
          "capitalization_denominator": {"type": ["number", "null"]},
          "capitalization_denominator_policy": {"type": ["string", "null"]},
          "qualified_financing_threshold": {"type": ["number", "null"]},
          "maturity_date": {"type": ["string", "null"]},
          "maturity_default_treatment": {"type": ["string", "null"], "enum": ["convert_at_cap", "repay", "extend", "counsel_review", null]},
          "maturity_conversion_price_override": {"type": ["number", "null"]},
          "non_qualified_financing_treatment": {"type": ["string", "null"], "enum": ["convert_anyway", "do_not_convert", "negotiate", null], "description": "Action when the financing round misses the qualified_financing_threshold. 'convert_anyway' = convert at cap/discount regardless of whether the threshold was met (there is no separate convert_at_cap value for this field). 'do_not_convert' = note stays outstanding. 'negotiate' = routes to counsel_review branch. null = no override (threshold_not_met branch is returned when the round misses the threshold)."},
          "source_document": {"type": ["string", "null"]},
          "extraction_confidence": {"enum": ["high", "medium", "low"]},
          "subtype": {"type": ["string", "null"], "enum": ["convertible_note", "convertible_loan_agreement", "convertible_security", null], "description": "Document-origin provenance marker. Math producers consume the canonical convertible_note shape regardless of subtype; subtype informs counsel-review framing (Israeli CLA / YC convertible_security / standard note). Soft default = 'convertible_note' per contract §10.2.5."},
          "governing_law": {"type": ["string", "null"], "enum": ["delaware", "israeli", "uk", "cayman", "other", null], "description": "Governing law of the instrument. Soft default = 'delaware' (or 'israeli' when inputs.jurisdiction.structure == 'israeli_ltd') per contract §10.2.5."}
        }
      }
    },
    "warrants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "shares_underlying", "exercise_price", "warrant_type", "issuance_date", "settlement_type", "vested_flag", "extraction_confidence"],
        "properties": {
          "id": {"type": "string"},
          "investor_name": {"type": ["string", "null"]},
          "shares_underlying": {"type": "integer", "minimum": 1},
          "exercise_price": {"type": ["number", "null"], "minimum": 0.0, "description": "Null ONLY when the strike is genuinely not stated in the source (documented-absent partial); never fabricate. Confirm with the founder before exercise math."},
          "warrant_type": {"enum": ["common_stock", "preferred_stock_series", "preferred_stock_blank_check"]},
          "preferred_series_id": {"type": ["string", "null"], "description": "When warrant_type=preferred_stock_series, which series this maps to."},
          "vested_flag": {"type": "boolean"},
          "vesting": {"type": ["object", "null"], "description": "Extension point (v0.5.0). Math producers do NOT read into the object; vesting fires via vested_flag. Tightens in v0.6.0+."},
          "issuance_date": {"type": "string"},
          "expiration_date": {"type": ["string", "null"]},
          "origin": {"type": ["string", "null"], "enum": ["debt_facility_kicker", "equipment_lease", "advisor_grant", "investor_kicker", "other", null]},
          "settlement_type": {"enum": ["cash_exercise", "net_share_settlement", "holder_election"]},
          "holder_election_choice": {"type": ["string", "null"], "enum": ["cash", "net_share", null], "description": "Required when settlement_type=holder_election; otherwise null. v0.5.0 invariant rejects E_WARRANT_HOLDER_ELECTION_UNSPECIFIED when missing."},
          "anti_dilution_clause": {"type": ["object", "null"], "description": "Extension point (v0.5.0). Math producers do NOT read into the interior — warrant repricing under issuer AD is not modeled in v0.5.0 (counsel-review only). When non-null, emits warrant.repricing_not_modeled counsel item."},
          "exercise_event_date": {"type": ["string", "null"], "description": "Date the warrant exercises (or has exercised). Drives run_scenario.py pre-round pump per §6.1.5."},
          "source_document": {"type": ["string", "null"]},
          "extraction_confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "option_grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "holder_id", "grant_date", "shares_granted", "strike_price", "plan_type"],
        "properties": {
          "id": {"type": "string"},
          "holder_id": {"type": "string"},
          "grant_date": {"type": "string"},
          "shares_granted": {"type": "integer", "minimum": 0},
          "shares_vested_to_date": {"type": ["integer", "null"], "minimum": 0},
          "shares_exercised": {"type": ["integer", "null"], "minimum": 0},
          "shares_outstanding_unvested": {"type": ["integer", "null"], "minimum": 0},
          "strike_price": {"type": ["number", "null"], "minimum": 0.0, "description": "Null ONLY when the strike is genuinely not stated in the source (documented-absent partial); never fabricate. Confirm with the founder before any strike-dependent analysis."},
          "plan_type": {"enum": ["iso", "nso", "section_102_cg", "section_102_oi", "section_3i"]},
          "section_102_trustee_deposit_date": {"type": ["string", "null"]},
          "vesting": {"type": ["object", "null"], "description": "Extension point (v0.5.0). Math producers do NOT read into the object; tightens in v0.6.0+."},
          "source_document": {"type": ["string", "null"]},
          "extraction_confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["run_id", "schema_version"],
      "properties": {
        "run_id": {"type": "string"},
        "schema_version": {"const": "v0.5.0-instruments"}
      }
    }
  }
}
