{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cap-table scenarios.json",
  "type": "object",
  "required": ["scenarios", "metadata"],
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "label", "type", "parameters", "computed_outputs"],
        "properties": {
          "scenario_id": {"type": "string"},
          "label": {"type": "string"},
          "type": {"enum": ["safe_conversion", "note_conversion", "priced_round", "flip"]},
          "parameters": {"type": "object"},
          "computed_outputs": {
            "type": "object",
            "required": ["completeness", "math_provenance", "blockers"],
            "properties": {
              "completeness": {"enum": ["full", "structural_only", "repay_only", "mixed"]},
              "cap_implied_only": {"type": "boolean"},
              "math_provenance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["output_field", "source_type"],
                  "properties": {
                    "output_field": {"type": "string"},
                    "source_type": {"enum": ["rule", "counsel_supplied_override", "solver_intermediate"]},
                    "rule_id": {"type": ["string", "null"]},
                    "rule_pack_version": {"type": ["string", "null"]},
                    "source_ref": {"type": ["string", "null"]}
                  }
                }
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "remedy"],
                  "properties": {
                    "code": {"type": "string"},
                    "instance_id": {"type": ["string", "null"]},
                    "remedy": {"type": "string"}
                  }
                }
              },
              "post_round_cap_table": {"type": "array"},
              "founder_impact": {
                "type": ["object", "null"],
                "properties": {
                  "before_pct": {"type": "number"},
                  "after_pct": {"type": "number"},
                  "delta_pp": {"type": "number"},
                  "plain_language": {"type": "string"}
                }
              },
              "aggregate_ownership_by_class": {
                "type": ["object", "null"],
                "description": "Includes optional `founders_pct_pre_anti_dilution`, `preferred_pct_pre_anti_dilution`, `anti_dilution_delta_pct_points` fields when AD fires on the scenario."
              },
              "aggregate_cash_repayment": {"type": ["number", "null"]},
              "per_note": {"type": ["object", "null"]},
              "per_safe": {"type": ["object", "null"]},
              "anti_dilution_breakdown": {
                "type": "array",
                "description": "Optional. Per-AD-protected-series breakdown emitted by AntiDilutionAdjuster. Present only when AD fired on at least one series.",
                "items": {
                  "type": "object",
                  "required": ["series_id", "protection_type", "ccp_before", "ccp_after", "rule_id"],
                  "properties": {
                    "series_id": {"type": "string"},
                    "protection_type": {"enum": ["broad_based_weighted_average", "narrow_based_weighted_average", "full_ratchet"]},
                    "ad_trigger_basis": {"enum": ["original_issue_price", "current_conversion_price"]},
                    "ad_a_denominator_basis": {"enum": ["nvca_broad", "nvca_narrow"]},
                    "trigger_price": {"type": "number"},
                    "new_pps": {"type": "number"},
                    "ccp_before": {"type": "number"},
                    "ccp_after": {"type": "number"},
                    "ccp_unfloored": {"type": "number"},
                    "floor_applied": {"type": "boolean"},
                    "A": {"type": "number"},
                    "B": {"type": ["number", "null"]},
                    "C": {"type": ["number", "null"]},
                    "rule_id": {"type": "string"},
                    "rule_pack_version": {"type": "string"}
                  }
                }
              },
              "ccp_mutations": {
                "type": "object",
                "description": "Optional. Map series_id -> CCP-after-this-scenario. Used by cap_state_after_round.json builder.",
                "additionalProperties": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["run_id"],
      "properties": {"run_id": {"type": "string"}}
    }
  }
}
