{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cap-table inputs.json",
  "description": "Founder-supplied + extracted engagement inputs. AoA extraction populates the `preferred_series` array + `aoa_findings` block. Founders block carries common-share holdings; option_pool carries existing pool sizing.",
  "type": "object",
  "required": ["company_name", "analysis_date", "mode", "metadata"],
  "properties": {
    "company_name": {"type": "string"},
    "analysis_date": {"type": "string"},
    "mode": {"enum": ["standard", "flip_focused"]},
    "jurisdiction": {
      "type": "object",
      "properties": {
        "structure": {"enum": ["delaware", "israeli", "delaware_with_israeli_sub", "mid_flip"]},
        "incorporated_date": {"type": "string"},
        "iia_grants_history": {
          "type": "object",
          "properties": {
            "has_grants": {"type": "boolean"},
            "grant_details": {"type": "array"}
          }
        }
      }
    },
    "event_dates": {
      "type": "object",
      "properties": {
        "restructuring_effective_date": {"type": ["string", "null"]},
        "restructuring_approval_date": {"type": ["string", "null"]},
        "filing_date": {"type": ["string", "null"]},
        "tax_position_date": {"type": ["string", "null"]},
        "flip_closing_date": {"type": ["string", "null"]},
        "benchmark_reference_date": {"type": ["string", "null"]}
      }
    },
    "founders": {
      "type": "array",
      "description": "Founder common-share holdings.",
      "items": {
        "type": "object",
        "required": ["name", "common_shares"],
        "properties": {
          "name": {"type": "string"},
          "founder_id": {"type": "string"},
          "common_shares": {"type": "integer", "minimum": 0},
          "common_class": {"type": "string", "default": "class_a"},
          "voting_rights_multiple": {"type": "number", "default": 1.0}
        }
      }
    },
    "common_batches": {
      "type": "array",
      "description": "Issued common-share batches beyond the founders block.",
      "items": {
        "type": "object",
        "properties": {
          "holder_id": {"type": "string"},
          "shares": {"type": "integer"},
          "issuance_date": {"type": "string"},
          "consideration": {"type": ["number", "null"]},
          "purpose": {"enum": ["founder_issuance", "restricted_stock_purchase", "exercise", "conversion", "other"]},
          "common_class": {"type": "string", "default": "class_a"},
          "voting_rights_multiple": {"type": "number", "default": 1.0}
        }
      }
    },
    "preferred_series": {
      "type": "array",
      "description": "Preferred-stock series. v0.5.0 removes dividend_rate_percent + dividend_cumulative (E_DIVIDEND_FIELDS_REMOVED if present); dividend provisions surface via aoa_findings.dividend_provisions_present for counsel-handoff.",
      "items": {
        "type": "object",
        "required": ["series_name", "shares", "original_issue_price", "original_conversion_price", "current_conversion_price", "issuance_date"],
        "properties": {
          "series_id": {"type": "string"},
          "series_name": {"type": "string"},
          "shares": {"type": "integer", "minimum": 0},
          "original_issue_price": {"type": "number", "exclusiveMinimum": 0},
          "original_conversion_price": {"type": "number", "exclusiveMinimum": 0},
          "current_conversion_price": {"type": "number", "exclusiveMinimum": 0},
          "issuance_date": {"type": "string"},
          "liquidation_preference_multiple": {"type": "number", "minimum": 1.0},
          "liquidation_preference_type": {"enum": ["non_participating", "participating", "participating_capped"]},
          "participation_cap_multiple": {"type": ["number", "null"]},
          "anti_dilution_protection": {"enum": ["none", "broad_based_weighted_average", "narrow_based_weighted_average", "full_ratchet"]},
          "ad_trigger_basis": {"enum": ["original_issue_price", "current_conversion_price"]},
          "ad_a_denominator_basis": {"enum": ["nvca_broad", "nvca_narrow"]},
          "ad_cp2_floor": {"type": ["number", "null"]},
          "ad_carve_outs": {"enum": ["nvca_default"]},
          "pro_rata_rights": {"type": "boolean"},
          "extraction_provenance": {
            "type": "object",
            "properties": {
              "source_doc": {"type": "string"},
              "extraction_confidence": {"enum": ["high", "medium", "low"]},
              "extracted_at": {"type": "string"}
            }
          }
        }
      }
    },
    "option_pool": {
      "type": "object",
      "required": ["plan_type", "authorized", "issued", "unallocated"],
      "properties": {
        "plan_type": {"enum": ["iso", "nso", "section_102_cg", "section_102_oi", "section_3i", "mixed"]},
        "authorized": {"type": "integer", "minimum": 0},
        "issued": {"type": "integer", "minimum": 0},
        "unallocated": {"type": "integer", "minimum": 0}
      }
    },
    "cap_table_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_type", "series_id"],
        "properties": {
          "event_type": {"enum": ["anti_dilution_applied", "warrant_exercised"]},
          "round_id": {"type": "string"},
          "applied_at": {"type": "string"},
          "series_id": {"type": "string"},
          "previous_ccp": {"type": "number"},
          "new_ccp": {"type": "number"},
          "rule_id": {"type": "string"},
          "rule_pack_version": {"type": "string"},
          "warrant_id": {"type": ["string", "null"]},
          "shares_added": {"type": ["integer", "null"]},
          "exercised_at_pps": {"type": ["number", "null"]}
        }
      }
    },
    "aoa_findings": {
      "type": "object",
      "description": "Source of truth for AoA-extracted findings. cap_state.py mirrors these into cap_state.aoa_findings (read-only mirror; never dual-written).",
      "properties": {
        "pay_to_play_detected": {"type": "boolean", "default": false},
        "drag_along_threshold_pct": {"type": ["number", "null"]},
        "section_102_plan_reference": {"type": ["boolean", "null"]},
        "ratchet_anti_dilution_detected": {"type": "boolean", "default": false},
        "liquidation_preference_above_1x": {"type": ["boolean", "null"]},
        "participation_present": {"type": ["boolean", "null"]},
        "dividend_provisions_present": {"type": ["boolean", "null"]},
        "protective_provisions_below_75_pct": {"type": ["boolean", "null"]},
        "bring_along_threshold_pct": {"type": ["number", "null"]}
      }
    },
    "engagement_questions": {"type": "array", "items": {"type": "string"}},
    "metadata": {
      "type": "object",
      "required": ["run_id", "schema_version"],
      "properties": {
        "run_id": {"type": "string"},
        "schema_version": {"const": "v0.5.0-inputs"},
        "cap_base_source": {
          "enum": ["confirmed", "assumed"],
          "description": "Whether the founder cap base (founders + share counts + pool) was founder-confirmed ('confirmed') or assumed/placeholder ('assumed'). Drives the S2 W_CAP_BASE_ASSUMED backstop; absent is treated as not-confirmed but only warns on a positive signal (placeholder names)."
        },
        "cap_base_provenance": {
          "type": "string",
          "description": "How the cap base was produced (lineage), distinct from whether it was confirmed. The freeform mapper stamps 'deterministic_mapped' when it produces the equity from the spreadsheet; a Lane-1/2/4 hand-build sets 'model_reconstructed' (or leaves it absent). cap_state emits W_CAP_BASE_RECONSTRUCTED when a 'confirmed' base is NOT 'deterministic_mapped' — so a model-built base can't masquerade as verified. Free string (no enum) so a model-set value never fails validation; the trigger keys on the absence of the exact 'deterministic_mapped' marker."
        },
        "extraction_mode": {
          "type": "string",
          "description": "How the source was read. Set to 'vision_image_pdf' when the pdf-probe detects an image-only PDF (no text layer) read by raw model vision (no OCR) — cap_state then emits W_VISION_EXTRACTION_LOW_CONFIDENCE so the structured artifacts carry the under-extraction caveat. Free string; the trigger keys on the exact 'vision_image_pdf' value."
        }
      }
    }
  }
}
