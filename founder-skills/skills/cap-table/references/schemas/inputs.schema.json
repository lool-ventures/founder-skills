{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cap-table inputs.json",
  "description": "Founder-supplied + extracted engagement inputs. AoA extraction (commit #7 post-J audit) populates the `preferred_series` array via the merge_aoa_to_inputs.py helper. Founders block carries common-share holdings; option_pool carries existing pool sizing.",
  "type": "object",
  "required": ["company_name", "analysis_date", "mode", "metadata"],
  "properties": {
    "company_name": {"type": "string"},
    "analysis_date": {"type": "string"},
    "mode": {"enum": ["standard", "flip_focused"]},
    "jurisdiction": {
      "type": "object",
      "properties": {
        "structure": {"enum": ["delaware", "israeli", "delaware_with_israeli_sub", "mid_flip"]},
        "incorporated_date": {"type": "string"},
        "iia_grants_history": {
          "type": "object",
          "properties": {
            "has_grants": {"type": "boolean"},
            "grant_details": {"type": "array"}
          }
        }
      }
    },
    "event_dates": {
      "type": "object",
      "properties": {
        "restructuring_effective_date": {"type": ["string", "null"]},
        "restructuring_approval_date": {"type": ["string", "null"]},
        "filing_date": {"type": ["string", "null"]},
        "tax_position_date": {"type": ["string", "null"]},
        "flip_closing_date": {"type": ["string", "null"]},
        "benchmark_reference_date": {"type": ["string", "null"]}
      }
    },
    "founders": {
      "type": "array",
      "description": "Founder common-share holdings. Consumed by cap_state.py to build the pre-financing snapshot.",
      "items": {
        "type": "object",
        "required": ["name", "common_shares"],
        "properties": {
          "name": {"type": "string"},
          "founder_id": {"type": "string"},
          "common_shares": {"type": "integer", "minimum": 0}
        }
      }
    },
    "common_batches": {
      "type": "array",
      "description": "Issued common-share batches beyond the founders block (e.g., advisor common, exercised options that didn't get split into a separate class).",
      "items": {
        "type": "object",
        "properties": {
          "holder_id": {"type": "string"},
          "shares": {"type": "integer"},
          "issuance_date": {"type": "string"},
          "consideration": {"type": ["number", "null"]},
          "purpose": {"enum": ["founder_issuance", "restricted_stock_purchase", "exercise", "conversion", "other"]}
        }
      }
    },
    "preferred_series": {
      "type": "array",
      "description": "Preferred-stock series. Schema mirrors cap_state.preferred_series item shape. Populated by AoA extraction (commit #7 post-J audit) via merge_aoa_to_inputs.py, OR directly from founder input via heredoc.",
      "items": {
        "type": "object",
        "required": ["series_name", "shares", "original_issue_price", "original_conversion_price", "current_conversion_price", "issuance_date"],
        "properties": {
          "series_id": {"type": "string"},
          "series_name": {"type": "string"},
          "shares": {"type": "integer", "minimum": 0},
          "original_issue_price": {"type": "number"},
          "original_conversion_price": {"type": "number"},
          "current_conversion_price": {"type": "number"},
          "issuance_date": {"type": "string"},
          "liquidation_preference_multiple": {"type": "number", "minimum": 1.0},
          "liquidation_preference_type": {"enum": ["non_participating", "participating", "participating_capped"]},
          "participation_cap_multiple": {"type": ["number", "null"]},
          "anti_dilution_protection": {"enum": ["none", "broad_based_weighted_average", "narrow_based_weighted_average", "full_ratchet"]},
          "dividend_rate_percent": {"type": ["number", "null"]},
          "dividend_cumulative": {"type": "boolean"},
          "pro_rata_rights": {"type": "boolean"},
          "extraction_provenance": {
            "type": "object",
            "description": "When populated via AoA extraction, records the source document + evidence quotes so downstream tooling can trace each preferred-series term back to the AoA. Absent for series populated by direct founder input.",
            "properties": {
              "source_doc": {"type": "string"},
              "extraction_confidence": {"enum": ["high", "medium", "low"]},
              "extracted_at": {"type": "string"}
            }
          }
        }
      }
    },
    "option_pool": {
      "type": "object",
      "description": "Existing option pool sizing. Consumed by cap_state.py + option_pool.py.",
      "required": ["plan_type", "authorized", "issued", "unallocated"],
      "properties": {
        "plan_type": {"enum": ["iso", "nso", "section_102_cg", "section_102_oi", "section_3i", "mixed"]},
        "authorized": {"type": "integer", "minimum": 0},
        "issued": {"type": "integer", "minimum": 0},
        "unallocated": {"type": "integer", "minimum": 0}
      }
    },
    "engagement_questions": {"type": "array", "items": {"type": "string"}},
    "metadata": {
      "type": "object",
      "required": ["run_id"],
      "properties": {"run_id": {"type": "string"}}
    }
  }
}
